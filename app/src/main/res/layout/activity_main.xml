<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvLongTaskResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultado Tarea Larga"
        android:textSize="18dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:id="@+id/tvSimpleTaskResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultado Tarea Simple"
        android:textSize="18dp"
        android:layout_marginBottom="16dp"/>
    <Button
        android:id="@+id/btnLongTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejecutar Long"
        android:layout_marginBottom="16dp"/>
    <Button
        android:id="@+id/btnSimpleTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejecutar Simple"
        android:layout_marginBottom="16dp"/>
</LinearLayout>